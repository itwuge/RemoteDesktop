# 文件: relay.conf.example | 用途: 中继服务配置模板 | 边界: 只含部署参数, 不含口令与私钥
# 部署时复制到 /etc/rdc-relay/relay.conf (0640 root:rdc), 由 deploy.py 自动完成
[server]
# 信令监听地址; 对外服务用 0.0.0.0, 只允许本机时用 127.0.0.1
bind = 0.0.0.0
port = 8750
# 额外监听端口: 逗号分隔, 与主端口共用同一套 accept 逻辑; 单个端口绑定失败只降级该端口
# extra_ports = 443
# 对外开放来源的端口: 仅这些端口放宽 allow_ips, 允许全局 IPv6 来源进入认证流程;
# 认证、连接码与 deny_ips 校验均不改变
# open_ports = 443
# 健康检查只监听回环, 不对外开放
health_bind = 127.0.0.1
health_port = 8751
# 同时存在的 TCP 连接上限, 包含信令连接; 3 Mbps 档建议不超过 64
max_connections = 64
# 单个来源 IP 的连接上限, 防止单机占满入口
max_connections_per_ip = 8
# 单个来源 IP 每分钟新建连接上限, 0 表示关闭; 用于挡住短时间重连风暴
connect_rate_per_min = 60

[security]
# IP 黑白名单, 逗号分隔, 支持 CIDR; 空值表示不限制
# deny_ips 优先级高于 allow_ips; allow_ips 非空时未列出的来源一律拒绝
# 例: allow_ips = 100.64.0.0/10, 1.2.3.4
allow_ips =
deny_ips =

[relay]
# 对外公布的中继地址; 按资源基线默认值: 主机 <ECS-IP>, 对外域名 <RELAY-DOMAIN>
endpoint = relay://<RELAY-DOMAIN>:8750
# 出口带宽, 单位 Mbps; 中继预算唯一来源, 不写死在代码里
# 资源基线实测出口 3 Mbps, 不要上调: 上调后单会话预算会突破实链路能力
egress_mbps = 3
# 协议与重传开销比例, 取值 [0, 1)
# 固定档按线上(wire)实测码率定预算: 3 Mbps 出口下单路 wire 上限 3000 kbps,
# 目标 2800 kbps 已含 base64+JSON+AEAD 封装, 不再二次扣 8%。
# 若换成不含封装的编码码率口径, 再按实际膨胀比填回本项。
overhead_ratio = 0.0
# 单节点最大并发会话数
# 3 Mbps 出口只承载 1 路 1080p30: 高运动场景由编码端自适应回落到 720p30,
# 数据面按 3000 kbps wire 预算逐帧限速。第 2 个客户端接入时由信令返回
# RELAY_FULL「中继通道已满，请等待或改用直连」, 不降画质、不排队。
# 本值只做并发闸门, 不参与降档决策。
max_sessions = 1
# 单会话最低预算, 低于此值不下发授予, 直接返回 RELAY_FULL;
# 固定档下该值只作兜底, 正常请求 2800 kbps 不会触发
min_session_kbps = 200
# 固定画质档: 1920x1080 @ 30fps; 高运动场景由编码端自适应回落到 720p30
# degrade_profile 仅为协议兼容字段, 固定档恒为 L0, 不参与自动切换
# target_kbps 是 wire 口径(含 base64+JSON+AEAD 封装), 由数据面按 1 秒窗口核对;
# 编码端净荷目标按 <=2500 kbps 配置, 给封装留余量; 实际线上超过本值时
# 数据面累加 budget_exceeded 并写 relay.dataplane/budget.exceeded 结构化日志。
target_kbps = 2800
profile_width = 1920
profile_height = 1080
profile_fps = 30
degrade_profile = L0

[wall_preview]
# 屏幕墙预览档 720p 默认值; 依据 docs/验收/带宽与画质核算报告-2026-11-10.md
# 实测(2026-11-10, 本机直连): 720p10 + 编码目标 200 kbps -> 线路 291 kbps, 文本区 SSIM 0.918;
# 编码目标 300 kbps -> 线路 392 kbps, 文本区 SSIM 0.9956
# 取 200 kbps: 线路占用 291 kbps, 落在现有 preview 300 kbps 上限内, 4 格合计约 1.2 Mbps
# 注意: 本段目前只作部署口径与接线依据, rdc.wall.budget 仍用代码常量
#       preview_480p15(854x480@15/300kbps); 接线为待办, 改这里不会立即生效
width = 1280
height = 720
fps = 10
# 单格编码目标码率, 单位 kbps; 线路字节约为其 1.45 倍(base64+JSON+AEAD)
# 200 kbps 对齐实测 720p10: 静态桌面线路 291 kbps、文本区 SSIM 0.918(可辨认布局)
kbps = 200
# 中继侧单格预算上限, 由信令授权直接读取本项(不再硬编码 300)
# 取 400: 720p 预览要读清正文需编码目标 300 kbps -> 线路实测 392 kbps,
#       原 300 kbps 上限会被卡住; 400 覆盖该实测值并留 8 kbps 余量
# 注意: docs/contracts/desktop-v1.md:124 仍写 preview_480p15 ≤300 kbps, 属契约缺口,
#       本项按实测上调, 契约文本待契约线同步, 不在本配置里私自改契约
max_session_kbps = 400
# 关键帧间隔, 按帧计; 10 等于 1 秒一个 IDR, 保证预览起播与切格重建在 1 秒内
keyint = 10
# 预取策略: 收到首个 IDR 前不出图; 之后最多预取 2 帧, 超出丢最旧帧
prefetch_frames = 2
prefetch_wait_keyframe = true

[logging]
# 结构化日志级别; Debug 默认关, 排障时临时调到 DEBUG 并尽快改回
level = INFO

[tls]
# TLS 1.3 传输加密; 安全默认必须为 true, 关闭即明文传输令牌与画面
# 部署脚本会拒绝写入 tls_enabled=false 的配置, 除非显式加 --allow-disable-tls(仅限调试)
tls_enabled = true
# 服务端证书链与私钥, tls_enabled=true 时必填; 只部署在服务器, 私钥不入仓库
# 自签方案: 由部署机生成 CA 与服务端证书, 客户端只需信任 CA 证书
cert_file = /etc/rdc-relay/tls/server.crt
key_file = /etc/rdc-relay/tls/server.key
# 客户端证书校验用 CA, 仅 require_client_cert=true 时使用
ca_file = /etc/rdc-relay/tls/ca.crt
# true 为双向校验(mTLS): 客户端必须出示由 ca_file 签发的证书
# 单向 TLS 只解决传输加密, 客户端仍靠 relay_token 鉴权; 不校验证书则无法防中间人冒充服务端
require_client_cert = false

