# 文件: relay.conf.example | 用途: 中继服务配置模板 | 边界: 只含部署参数, 不含口令与私钥
# 部署时复制到 /etc/rdc-relay/relay.conf (0640 root:rdc), 由 deploy.py 自动完成
[server]
# 信令监听地址; 对外服务用 0.0.0.0, 只允许本机时用 127.0.0.1
bind = 0.0.0.0
port = 8750
# 健康检查只监听回环, 不对外开放
health_bind = 127.0.0.1
health_port = 8751
# 同时存在的 TCP 连接上限, 包含信令连接; 3 Mbps 档建议不超过 64
max_connections = 64
# 单个来源 IP 的连接上限, 防止单机占满入口
max_connections_per_ip = 8
# 单个来源 IP 每分钟新建连接上限, 0 表示关闭; 用于挡住短时间重连风暴
connect_rate_per_min = 60

[security]
# IP 黑白名单, 逗号分隔, 支持 CIDR; 空值表示不限制
# deny_ips 优先级高于 allow_ips; allow_ips 非空时未列出的来源一律拒绝
# 例: allow_ips = 100.64.0.0/10, 1.2.3.4
allow_ips =
deny_ips =

[relay]
# 对外公布的中继地址; 按资源基线默认值: 主机 <ECS-IP>, 对外域名 <RELAY-DOMAIN>
endpoint = relay://<RELAY-DOMAIN>:8750
# 出口带宽, 单位 Mbps; 中继预算唯一来源, 不写死在代码里
# 资源基线实测出口 3 Mbps, 不要上调: 上调后单会话预算会突破实链路能力
egress_mbps = 3
# 协议与重传开销比例, 取值 [0, 1)
overhead_ratio = 0.08
# 单节点最大并发会话数
# 先按 2 路设: 3 Mbps 扣掉 8% 开销后约 2760 kbps, 2 路各 1380 kbps 只能跑 L1/L2;
# 若开到 4 路则每路约 690 kbps, 画质会被压到 360p 以下, 低于产品可接受下限, 因此默认 2。
# 该值是替用户先定的默认值, 用户改带宽或改策略后重新计算即可, 不需要改代码。
max_sessions = 2
# 单会话最低预算, 低于此值不下发授予, 直接返回 RELAY_FULL
min_session_kbps = 200
# 默认降档档位: L0 720p30 / L1 540p30 / L2 360p20 / L3 200kbps 保活
degrade_profile = L0

[logging]
# 结构化日志级别; Debug 默认关, 排障时临时调到 DEBUG 并尽快改回
level = INFO

[tls]
# TLS 1.3 传输加密; 默认 false 时行为与未接入 TLS 前完全一致(明文 TCP)
tls_enabled = false
# 服务端证书链与私钥, tls_enabled=true 时必填; 只部署在服务器, 私钥不入仓库
# 自签方案: 由部署机生成 CA 与服务端证书, 客户端只需信任 CA 证书
cert_file = /etc/rdc-relay/tls/server.crt
key_file = /etc/rdc-relay/tls/server.key
# 客户端证书校验用 CA, 仅 require_client_cert=true 时使用
ca_file = /etc/rdc-relay/tls/ca.crt
# true 为双向校验(mTLS): 客户端必须出示由 ca_file 签发的证书
# 单向 TLS 只解决传输加密, 客户端仍靠 relay_token 鉴权; 不校验证书则无法防中间人冒充服务端
require_client_cert = false

